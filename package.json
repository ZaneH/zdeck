{
  "name": "deck-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Deck local editor and phone preview with native OBS scene switching in the desktop app.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "storybook:test": "vitest run --project=storybook",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:remote": "npm run build && nix develop --command cargo test --manifest-path src-tauri/Cargo.toml --test remote_service remote_browser_smoke -- --ignored --nocapture --test-threads=1",
    "smoke:native": "nix develop --command bash -c 'npm run tauri:build -- --debug --no-bundle --features native-smoke && node scripts/native-smoke.mjs'",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "storybook build -o storybook-static --disable-telemetry",
    "landing:dev": "vite --config vite.landing.config.ts",
    "landing:build": "vite build --config vite.landing.config.ts",
    "plugin:package:spotify": "node scripts/package-spotify.mjs",
    "plugin:package:home-assistant": "node scripts/package-home-assistant.mjs",
    "plugin:zdx:spotify": "node scripts/package-zdx.mjs spotify",
    "plugin:zdx:home-assistant": "node scripts/package-zdx.mjs home-assistant",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@argos-ci/cli": "^6.15.0",
    "@argos-ci/storybook": "^6.5.2",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/react-vite": "10.6.8",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^5.1.2",
    "@vitest/browser-playwright": "^5.1.2",
    "playwright": "^1.65.1",
    "fflate": "0.8.3",
    "storybook": "10.6.8",
    "typescript": "^5.7.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.2"
  }
}
